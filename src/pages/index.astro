---
import Base from "../components/Base.astro";
import Ornament from "../components/Ornament.astro";
import ProductCard from "../components/ProductCard.astro";
import { getProduct } from "../data/catalog";

const featured = ["column-dress-chalk", "petal-slip", "river-jean", "ivory-vneck"]
  .map((handle) => getProduct(handle))
  .filter((product) => product !== undefined);
---

<Base title="Prism & Pollen" description="A paper-ground preview of Prism & Pollen. Nothing is for sale.">
  <section class="hero">
    <img src="/brand/petal-slip.jpeg" alt="Petal slip in a warm studio plate." />
    <div class="hero-copy">
      <h1 class="caps">The paper edit</h1>
      <Ornament />
      <a class="text-link" href="/collections/new-arrivals">Shop new arrivals</a>
    </div>
  </section>

  <div class="story-row">
    <a class="story" href="/collections/dresses">
      <img src="/brand/column-dress.jpeg" alt="Column dress in chalk." />
      <span class="story-label">Dresses<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
    <a class="story" href="/collections/denim">
      <img src="/brand/river-jean.jpeg" alt="River jean in a mid wash." />
      <span class="story-label">Denim<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
  </div>

  <section class="section">
    <h2 class="script">Explore</h2>
    <p class="lede">Four plates from the preview. Photographs that were not supplied stay labeled that way.</p>
  </section>
  <div class="explore-grid">
    <a class="story" href="/collections/knitwear">
      <img src="/brand/ivory-knit.jpeg" alt="Ivory knit." />
      <span class="story-label">Knit<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
    <a class="story" href="/collections/outerwear">
      <img src="/brand/studio-jacket.jpeg" alt="Pink studio jacket." />
      <span class="story-label">Outerwear<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
    <a class="story" href="/pages/lookbook">
      <img src="/brand/noir-dress.jpeg" alt="Black floral studio plate, not a separate catalog piece." />
      <span class="story-label">Paper study<i class="gem a"></i><i class="gem b"></i><i class="gem c"></i><i class="gem d"></i></span>
    </a>
  </div>

  <section class="section">
    <h2 class="script">New arrivals</h2>
  </section>
  <div class="product-grid">
    {featured.map((product) => <ProductCard product={product} />)}
  </div>
  <p class="section"><a class="text-link" href="/collections/new-arrivals">View the edit</a></p>
</Base>
