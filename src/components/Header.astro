---
import {
  collectionLinks,
  discoverLinks,
  shopColumns,
} from "../data/catalog";
---

<a class="skip" href="#content">Skip to content</a>
<p class="announce">Prototype — payments, accounts, email, and SMS are off</p>
<header class="site-header">
  <div class="bar">
    <div class="left">
      <button
        class="icon-btn mobile-toggle"
        id="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="menu-dialog"
        aria-label="Open menu"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
      <nav class="desktop-nav" aria-label="Primary">
        <a class="nav-btn" href="/collections/new-arrivals">New</a>
        <div class="nav-item" id="shop-wrap">
          <button
            class="nav-btn"
            id="shop-button"
            type="button"
            aria-expanded="false"
            aria-controls="mega-shop"
          >
            Shop
          </button>
          <div class="mega" id="mega-shop">
            {
              shopColumns.map((column) => (
                <div>
                  <h2>{column.title}</h2>
                  {column.links.map((link) => (
                    <a href={link.href}>
                      {link.label}
                      {link.note ? <span class="quiet"> — {link.note}</span> : null}
                    </a>
                  ))}
                </div>
              ))
            }
            <a class="mega-photo" href="/collections/new-arrivals" tabindex="-1">
              <img src="/brand/petal-slip.jpeg" alt="" />
            </a>
          </div>
        </div>
        <div class="nav-item">
          <button class="nav-btn" type="button" aria-expanded="false" aria-controls="pop-collections">
            Collections
          </button>
          <div class="menu-pop" id="pop-collections">
            <h2>Collections</h2>
            {collectionLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        </div>
        <div class="nav-item">
          <button class="nav-btn" type="button" aria-expanded="false" aria-controls="pop-discover">
            Discover
          </button>
          <div class="menu-pop" id="pop-discover">
            <h2>Discover</h2>
            {
              discoverLinks.map((link) => (
                <a href={link.href}>
                  {link.label}
                  {link.note ? <span class="quiet"> — {link.note}</span> : null}
                </a>
              ))
            }
          </div>
        </div>
      </nav>
    </div>
    <a class="wordmark" href="/">Prism &amp; Pollen</a>
    <div class="right">
      <a class="util-link" href="/pages/account">Account</a>
      <a class="currency-link" href="/pages/currency">USD</a>
      <button class="icon-btn" id="search-open" type="button" aria-label="Search" aria-controls="search-dialog" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6"></circle>
          <path d="M16 16.5 20 21"></path>
        </svg>
      </button>
      <a class="util-link" href="/pages/assistance">Assistance</a>
      <button class="icon-btn" id="bag-button" type="button" aria-controls="cart-dialog" aria-expanded="false">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 8h12l-1 12H7L6 8Z"></path>
          <path d="M9 8V7a3 3 0 0 1 6 0v1"></path>
        </svg>
        <span class="bag-count" id="bag-count">0</span>
        <span class="sr-only" id="bag-label">Bag, 0 items</span>
      </button>
    </div>
  </div>
</header>
