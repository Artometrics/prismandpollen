---
import Ornament from "./Ornament.astro";
---
<section class="notes" id="stay" aria-label="Messages">
  <h2 class="caps">Stay in touch</h2>
  <Ornament />
  <p>Keep up to date on the latest happenings in our world—launches, updates to our Impact Report, and more—when you subscribe.</p>
  <p class="quiet">Reference newsletter sentence. Email is off. Nothing is collected. No impact report is published.</p>
  <form id="newsletter-form" novalidate>
    <label class="email-line">
      <span>Email address</span>
      <input type="email" name="email" disabled autocomplete="off" />
    </label>
  </form>
</section>
<footer class="site-footer" id="footer">
  <p class="footer-lockup">
    <svg viewBox="0 0 280 78" role="img" aria-label="Prism &amp; Pollen">
      <path d="M40 39c18-22 36-22 54 0 18 22 36 22 54 0 18-22 36-22 54 0 18 22 36 22 54 0" fill="none" stroke="#2a241e" stroke-width="1"/>
      <rect x="78" y="22" width="124" height="34" rx="17" fill="none" stroke="#2a241e" stroke-width="1"/>
      <text x="140" y="43" text-anchor="middle" fill="#2a241e">PRISM &amp; POLLEN</text>
    </svg>
  </p>
  <div class="footer-links">
    <div>
      <a href="/pages/not-in-preview">Accessibility</a>
      <a href="/pages/privacy">Your privacy choices</a>
      <a href="/pages/terms">Terms of use</a>
      <a href="/pages/privacy">Legal &amp; privacy</a>
    </div>
    <p class="fine">Prototype · not a store · no index<br />Reference campaign. Rights not cleared.</p>
    <div>
      <a href="/pages/not-in-preview">Track your order</a>
      <a href="/pages/not-in-preview">Start a return</a>
      <a href="/pages/not-in-preview">Manage pre-order</a>
      <a href="/products/digital-gift-card">Gift cards</a>
      <a href="/pages/shops">Find a shop</a>
      <a href="/pages/faq">FAQ</a>
      <a href="/pages/contact">Contact us</a>
      <a href="/pages/not-in-preview">Careers</a>
      <a href="/pages/assistance">Live chat</a>
    </div>
  </div>
</footer>
