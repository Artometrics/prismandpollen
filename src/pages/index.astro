---
import Base from "../components/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/catalog";

const apparel = products.filter((product) => product.kind === "apparel");
---

<Base title="Prism & Pollen" description="Prism & Pollen preview of the supplied reference catalog. Nothing is for sale.">
  <header class="page-head">
    <p class="quiet">Homepage campaign</p>
    <h1 class="script">Waiting on capture</h1>
    <p class="lede">
      The supplied desktop home shot is a viewport with the shop menu open. The mobile home shot is cut off before the footer.
      The visible hero line and the section order are recorded in the fidelity ledger. The campaign photographs and motion were not files we can ship, so they are not reconstructed.
    </p>
    <p><a class="text-link" href="/collections/new-arrivals">Twelve-product handoff</a></p>
  </header>
  <div class="product-grid">
    {apparel.map((product) => <ProductCard product={product} />)}
  </div>
</Base>
